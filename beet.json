{
    "data_pack": {
        "load": [
            "src"
        ],
        "name": "Multiblocks"
    },
    "pipeline": [
        "plugins.aliases",
        "plugins.mtb_main",
        "mecha"
    ],
    "id": "mtb",
    "name": "mtb",
    "description": "Create custom multiblock structures with ease!",
    "require": [
        "bolt"
    ],
    "output": "build",
    "meta": {
        "bolt": {
            "entrypoint": [
                "mtb:main"
            ]
        },
        "aliases": [
            {
                "regex": "__pack_major__",
                "replace": "1",
                "comment": "The major version of this library"
            },
            {
                "regex": "__pack_minor__",
                "replace": "0",
                "comment": "The minor version of this library"
            },
            {
                "regex": "@debug << (.*)",
                "replace": "execute if score #mtb.debug_enabled temp matches 1 run tellraw @a[tag=mtb.debug] \\g<1>",
                "comment": "An alias for debugging"
            }
        ]
    }
}