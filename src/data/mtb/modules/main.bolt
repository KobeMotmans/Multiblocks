# <description of the curr file>


#-----------------------------------------------------------------------------------------------------------------------------------------------------
##        SETTINGS
#-----------------------------------------------------------------------------------------------------------------------------------------------------
# settings used to balance the minigame

#-----------------------------------------------------------------------------------------------------------------------------------------------------
##        INCLUDES
#-----------------------------------------------------------------------------------------------------------------------------------------------------
# Import all the things we need
import mtb:struct_scanner as struct

#-----------------------------------------------------------------------------------------------------------------------------------------------------
##    PYTHON UTILITIES
#-----------------------------------------------------------------------------------------------------------------------------------------------------
# helper python functions used by any of the stages

#-----------------------------------------------------------------------------------------------------------------------------------------------------
##    GENERATION STAGE
#-----------------------------------------------------------------------------------------------------------------------------------------------------
# The generation stage generates all resourcepack files that can be generated using code

predicate mtb:match_id {
  "condition": "minecraft:entity_scores",
  "entity": "this",
  "scores": {
    "mtb_id": {
      "min": { 
        "type": "minecraft:score", 
        "target": {
            "type": "minecraft:fixed", 
            "name": ".this" 
            },
             "score": "mtb_id" 
             },
      "max": { 
        "type": "minecraft:score", 
        "target": { 
            "type": "minecraft:fixed", 
            "name": ".this" 
            }, 
            "score": "mtb_id" 
            }
    }
  }
}
#-----------------------------------------------------------------------------------------------------------------------------------------------------
##      DATA STAGE
#-----------------------------------------------------------------------------------------------------------------------------------------------------
# generate all datapack files
structs = {}
for naam, struct, palet, center in struct.get_structure_list():
    structs[naam] = (struct, palet, center)
#---------------
# FUNCTION TAGS 
#---------------

append function_tag minecraft:tick {
    "values": [
        "mtb:tick"
    ]
}

append function_tag minecraft:load {
    "values": [
        "mtb:load",
        "theblackswitch:load"
    ]
}


#-----------------------------------------------------------------------------------------------------------------------------------------------------
##       RUN STAGE
#-----------------------------------------------------------------------------------------------------------------------------------------------------
# All functions that run during the game


#------------------
## TICK FUNCTIONS
#------------------

function mtb:tick:
    execute as @a at @s run function mtb:player

function mtb:player:
    scoreboard players enable @s mirror
    scoreboard players enable @s rotate

    for mtb in structs.keys():
        execute as @s at @e[distance=(0,10),type=marker,tag=rotor, tag=INIT, tag=mtb] align xyz positioned ~0.50 ~ ~0.50 run function f"mtb:{mtb}/spawn_marker"
        execute as @e[distance=(0,10),type=minecraft:block_display,tag=mtb] at @s align xyz positioned ~0.50 ~0.50 ~0.50 run function f"mtb:{mtb}/multiblock_block_check"
        execute as @e[distance=(0,10),type=marker,tag=mtb] at @s align xyz positioned ~0.50 ~0.50 ~0.50 run function f"mtb:{mtb}/multiblock_check"

for mtb in structs.keys():
    function f"mtb:{mtb}/spawn_marker":
        execute if entity @s[y_rotation=135..225] run summon marker ~ ~ ~ {Rotation:[180f,0f], Tags:[mtb,INIT]}
        execute if entity @s[y_rotation=225..315] run summon marker ~ ~ ~ {Rotation:[270f,0f], Tags:[mtb,INIT]}
        execute if entity @s[y_rotation=315..] run summon marker ~ ~ ~ {Rotation:[0f,0f], Tags:[mtb,INIT]}
        execute if entity @s[y_rotation=..45] run summon marker ~ ~ ~ {Rotation:[0f,0f], Tags:[mtb,INIT]}
        execute if entity @s[y_rotation=45..135] run summon marker ~ ~ ~ {Rotation:[90f,0f], Tags:[mtb,INIT]}
        summon interaction ~ ~ ~ {Tags:[(mtb), INIT]}
        center = structs[mtb][2]
        center_y = center[1]+0.5
        center_z = center[2]
        tag @e[distance=(0,1),type=marker,tag=rotor, tag=INIT] remove INIT
        execute as @e[distance=(0,0.1),type=marker,tag=(mtb), tag=INIT] at @s rotated as @s:
            tp @s ^ ^center_y ^center_z
            execute at @s run function f"mtb:{mtb}/multiblock_init"
        kill @e[distance=(0,1),type=marker,tag=rotor]

    
    function f"mtb:{mtb}/multiblock_init":
        if entity @s[tag=INIT] run tag @s remove INIT
        execute unless entity @s[tag=has_mtb_id] run function f"mtb:assign_id"
        scoreboard players operation @e[type=interaction, tag=(mtb), tag=INIT, sort=nearest, limit=1] mtb_id = @s mtb_id
        execute as @e[type=interaction, tag=(mtb), tag=INIT, limit=1] run tag @s remove INIT
        for item in structs[mtb][0]:
            block= item[0]
            block_stripped = item[1]
            pos = item[2]
            unless entity @s[tag=mirrored]:
                summon block_display ^pos[0] ^pos[1] ^pos[2] {transformation:{left_rotation:[0f,0f,0f,1f],right_rotation:[0f,0f,0f,1f],translation:[-0.3f,-0.3f,-0.3f],scale:[0.6f,0.6f,0.6f]},block_state:{Name:block},Tags:[(mtb), (block_stripped)]}
                execute positioned ^pos[0] ^pos[1] ^pos[2] run scoreboard players operation @e[distance=..0.1, type=block_display, tag=(mtb), limit=1] mtb_id = @s mtb_id
            if entity @s[tag=mirrored]:
                mirror_pos = pos[0]*(-1)
                summon block_display ^mirror_pos ^pos[1] ^pos[2] {transformation:{left_rotation:[0f,0f,0f,1f],right_rotation:[0f,0f,0f,1f],translation:[-0.3f,-0.3f,-0.3f],scale:[0.6f,0.6f,0.6f]},block_state:{Name:block},Tags:[(mtb), (block_stripped)]}
                execute positioned ^mirror_pos ^pos[1] ^pos[2] run scoreboard players operation @e[distance=..0.1, type=block_display, tag=(mtb), limit=1] mtb_id = @s mtb_id  
    
    function f"mtb:{mtb}/multiblock_block_check":
            for block in structs[mtb][1]:
                if entity @s[tag=(block.replace("minecraft:", ""))]:
                    if block ~ ~ ~ minecraft:air unless score @s got_block matches 0:
                        if score @s got_block matches 2 run execute as @e[distance=(0,5),type=marker,tag=(mtb)] scoreboard players remove @s mtb_complete 1
                        scoreboard players set @s got_block 0
                        kill @e[distance=..0.1, type=item_display, tag=outline]
                    if block ~ ~ ~ (block) unless score @s got_block matches 2:
                        scoreboard players set @s got_block 2
                        execute as @e[distance=(0,5),type=marker,tag=(mtb)] scoreboard players add @s mtb_complete 1
                    unless block ~ ~ ~ (block) unless block ~ ~ ~ minecraft:air unless score @s got_block matches 1:
                        scoreboard players set @s got_block 1
                        summon item_display ~ ~ ~ {item:{id:"minecraft:poisonous_potato",count:1,components:{"minecraft:item_model":"minecraft:red_stained_glass"}},Tags:[outline]}
    
    
    function f"mtb:{mtb}/multiblock_check":
        function f"mtb:find_id"
        execute as @e[type=interaction, tag=(mtb), predicate=f"mtb:match_id"] at @s run function f"mtb:{mtb}/interaction"
        if score @s mtb_complete matches len(structs[mtb][0]):
            say "Full house!"

    function f"mtb:{mtb}/interaction":
        execute on target:
            scoreboard players operation @s mtb_id = @e[distance=..1, type=interaction, tag=(mtb), sort=nearest, limit=1] mtb_id
            raw dialog show @s mtb:mtb_transform
        data remove entity @s interaction
        function f"mtb:find_id"
        execute if score @a[distance=..10, predicate=f"mtb:match_id", limit=1] rotate matches 10:
            scoreboard players set @e[limit=1, distance=(0,10),type=marker,tag=mtb] mtb_complete 0
            kill @e[distance=..10, type=minecraft:block_display, predicate=f"mtb:match_id"]
            execute as @e[distance=..10, type=marker, predicate=f"mtb:match_id", limit=1] at @s:
                rotate @s facing ^90 ^ ^
                execute rotated as @s run function f"mtb:{mtb}/multiblock_init"
            scoreboard players set @p[distance=..10, predicate=f"mtb:match_id", limit=1] rotate 0
        execute if score @a[distance=..10, predicate=f"mtb:match_id", limit=1] mirror matches 10:
            scoreboard players set @e[limit=1, distance=(0,10),type=marker,tag=mtb] mtb_complete 0
            kill @e[distance=..10, type=minecraft:block_display, predicate=f"mtb:match_id"]
            execute as @e[distance=..10, type=marker, predicate=f"mtb:match_id", limit=1] at @s:
                execute if entity @s[tag=mirrored] run tag @s add was_mirrored
                execute if entity @s[tag=was_mirrored] run tag @s remove mirrored
                execute unless entity @s[tag=was_mirrored] run tag @s add mirrored
                execute if entity @s[tag=was_mirrored] run tag @s remove was_mirrored
                function f"mtb:{mtb}/multiblock_init"
            scoreboard players set @p[distance=..10, predicate=f"mtb:match_id", limit=1] mirror 0




# item_display
#summon block_display ~ ~ ~ {transformation:{left_rotation:[0f,0f,0f,1f],right_rotation:[0f,0f,0f,1f],translation:[-0.3f,-0.3f,-0.3f],scale:[0.6f,0.6f,0.6f]},block_state:{Name:"minecraft:dirt"}}

#------------------
## LOAD FUNCTIONS
#------------------

function f"mtb:load":
    say "Reload Complete!"
    scoreboard objectives add mtb_complete dummy
    scoreboard objectives add got_block dummy
    schedule function f"mtb:set_version" 1t
    scoreboard objectives add mtb_id dummy

    scoreboard objectives add mirror trigger
    scoreboard objectives add rotate trigger

function f"mtb:set_version":
    data modify storage theblackswitch:versions packs append value {pack:"mtb",version:[1,0,0],lib_version:[1,0,0]}
    data modify storage theblackswitch:versions lib.loaded_from set value "mtb"

function f"mtb:assign_id":
    scoreboard players operation @s mtb_id = .max mtb_id
    tag @s add has_mtb_id
    # Increment the max player ID by one
    scoreboard players add .max mtb_id 1

function f"mtb:find_id":
    # Set .this to the current entity's ID
    scoreboard players operation .this mtb_id = @s mtb_id


