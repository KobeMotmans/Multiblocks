# <description of the curr file>


#-----------------------------------------------------------------------------------------------------------------------------------------------------
##        SETTINGS
#-----------------------------------------------------------------------------------------------------------------------------------------------------
# settings used to balance the minigame

#-----------------------------------------------------------------------------------------------------------------------------------------------------
##        INCLUDES
#-----------------------------------------------------------------------------------------------------------------------------------------------------
# Import all the things we need
import mtb:struct_scanner as struct_scanner

#-----------------------------------------------------------------------------------------------------------------------------------------------------
##    PYTHON UTILITIES
#-----------------------------------------------------------------------------------------------------------------------------------------------------
# helper python functions used by any of the stages

#-----------------------------------------------------------------------------------------------------------------------------------------------------
##    GENERATION STAGE
#-----------------------------------------------------------------------------------------------------------------------------------------------------
# The generation stage generates all resourcepack files that can be generated using code


#-----------------------------------------------------------------------------------------------------------------------------------------------------
##      DATA STAGE
#-----------------------------------------------------------------------------------------------------------------------------------------------------
# generate all datapack files
structs = {}
for struct in struct_scanner.get_structure_list():
    structs[struct[0]] = struct[1::]

structs_OOP = {}
for struct in struct_scanner.create_structures():
    structs_OOP[struct.id] = struct

#---------------
# FUNCTION TAGS 
#---------------

append function_tag minecraft:tick {
    "values": [
        {"id": "mtb:tick", "required": false}
    ]
}

append function_tag minecraft:load {
    "values": [
        {"id":"mtb:load", "required": false}
    ]
}


# -------------------------------
# Match mtb id predicate                            
# -------------------------------

predicate mtb:match_id {
    "condition": "minecraft:entity_scores",
    "entity": "this",
    "scores": {
        "mtb_id": {
            "min": { 
                "type": "minecraft:score", 
                "target": {
                    "type": "minecraft:fixed", 
                    "name": ".this" 
                },
                "score": "mtb_id" 
            },
            "max": { 
                "type": "minecraft:score", 
                "target": { 
                    "type": "minecraft:fixed", 
                    "name": ".this" 
                }, 
                "score": "mtb_id" 
            }
        }
    }
}


#-----------------------------------------------------------------------------------------------------------------------------------------------------
##       RUN STAGE
#-----------------------------------------------------------------------------------------------------------------------------------------------------
# All functions that run during the game




# ==========================================================================================================================================
# ------------------------------------------------------------------------------------------------------------------------------------------
##                                                      Multiblock Specific Code                                                                       
# ------------------------------------------------------------------------------------------------------------------------------------------
# ==========================================================================================================================================


for curr_mtb_id in structs_OOP.keys():


    #-------------------------------------------------------------
    ## Add all user-interacted functions to tags for easier use
    #-------------------------------------------------------------

    # Place function
    append function_tag f"mtb-generated:{curr_mtb_id}/place_blueprint" {
        "values": [
            {"id": f"mtb-generated:{curr_mtb_id}/spawn_marker", "required": false}
        ]
    }

    # TODO: remove function, rotate function, mirror function and place structure function

    #-------------------------------------------------------
    ## MAIN INTERNAL CODE
    #-------------------------------------------------------

    function f"mtb-generated:{curr_mtb_id}/spawn_marker": # Misschien nog een betere naam bedenken
        data remove storage mtb:temp args
        $data modify storage mtb:temp args set value $(args)

        execute align xyz positioned ~0.50 ~ ~0.50:

            execute:
                if data storage mtb:temp {"args":{"rotation": "180"}} run return run summon marker ~ ~ ~ {Rotation:[180f,0f], Tags:[curr_mtb_id,"INIT"]}
                if data storage mtb:temp {"args":{"rotation": "270"}} run return run summon marker ~ ~ ~ {Rotation:[270f,0f], Tags:[curr_mtb_id,"INIT"]}
                if data storage mtb:temp {"args":{"rotation": "90"}} run return run summon marker ~ ~ ~ {Rotation:[90f,0f], Tags:[curr_mtb_id,"INIT"]}
                summon marker ~ ~ ~ {Rotation:[0f,0f], Tags:[curr_mtb_id,"INIT"]} # fallback

            center = structs_OOP[curr_mtb_id].center
            center_y = center[1]+0.5
            center_z = center[2]
            kill @e[sort=nearest, limit=1, distance=(0,1),type=marker,tag=rotor, tag=INIT]
            execute as @e[sort=nearest, limit=1, distance=(0,0.1),type=marker,tag=(curr_mtb_id), tag=INIT] at @s rotated as @s:
                tp @s ^ ^center_y ^center_z
                execute at @s run function f"mtb-generated:{curr_mtb_id}/multiblock_init"


    # ------------------------------------------------------------------------------------------------------------------------------------------
    
    function f"mtb-generated:{curr_mtb_id}/multiblock_init": # Misschien nog een betere naam bedenken
        tag @s remove INIT
        execute unless entity @s[tag=has_mtb_id] run function mtb:assign_id

        #TODO: Fix OOP en werk niemeer met lijsten ma met objecten
        for blockdata in structs_OOP[curr_mtb_id].blocks:
            block = blockdata.id
            block_stripped = blockdata.stripped_id
            pos = blockdata.pos
            mirror_pos = pos[0]*(-1)

            # store the marker ID for later use
            scoreboard players operation #marker_id temp = @s mtb_id

            # ======= Handle most block block display summons =======
            if not block_stripped in ["water", "lava"]:
                if entity @s[tag=mirrored] run return:
                    execute positioned ^mirror_pos ^pos[1] ^pos[2] summon minecraft:block_display:
                        data merge entity @s {transformation:{left_rotation:[0f,0f,0f,1f],right_rotation:[0f,0f,0f,1f],translation:[-0.3f,-0.3f,-0.3f],scale:[0.6f,0.6f,0.6f]},block_state:{Name:block},Tags:[(curr_mtb_id), (block_stripped)]}
                        scoreboard players operation @s mtb_id = #marker_id temp  
                        scoreboard players set @s got_block 0

                positioned ^pos[0] ^pos[1] ^pos[2] summon block_display: 
                    data merge entity @s {transformation:{left_rotation:[0f,0f,0f,1f],right_rotation:[0f,0f,0f,1f],translation:[-0.3f,-0.3f,-0.3f],scale:[0.6f,0.6f,0.6f]},block_state:{Name:block},Tags:[(curr_mtb_id), (block_stripped)]}
                    scoreboard players operation @s mtb_id = #marker_id temp
                    scoreboard players set @s got_block 0

            # ======= Handle water item-display placement =======
            elif block_stripped == "water":
                unless entity @s[tag=mirrored]:
                    positioned ^pos[0] ^pos[1] ^pos[2] summon item_display:
                        data merge entity @s {transformation:{left_rotation:[0f,0f,0f,1f],right_rotation:[0f,0f,0f,1f],translation:[0f,0f,0f],scale:[0.6f,0.6f,0.6f]},item:{id:"minecraft:water_bucket"},Tags:[(curr_mtb_id), (block_stripped)]}
                        scoreboard players operation @s mtb_id = #marker_id temp
                        scoreboard players set @s got_block 0
                
                if entity @s[tag=mirrored]:
                    positioned ^mirror_pos ^pos[1] ^pos[2] summon item_display:
                        data merge entity @s {transformation:{left_rotation:[0f,0f,0f,1f],right_rotation:[0f,0f,0f,1f],translation:[0f,0f,0f],scale:[0.6f,0.6f,0.6f]},item:{id:"minecraft:water_bucket"},Tags:[(curr_mtb_id), (block_stripped)]}
                        scoreboard players operation @s mtb_id = #marker_id temp
                        scoreboard players set @s got_block 0
            
            # ======= Handle lava item-display placement =======
            elif block_stripped == "lava":
                unless entity @s[tag=mirrored]:
                    positioned ^pos[0] ^pos[1] ^pos[2] summon item_display:
                        data merge entity @s {transformation:{left_rotation:[0f,0f,0f,1f],right_rotation:[0f,0f,0f,1f],translation:[0f,0f,0f],scale:[0.6f,0.6f,0.6f]},item:{id:"minecraft:lava_bucket"},Tags:[(curr_mtb_id), (block_stripped)]}
                        scoreboard players operation @s mtb_id = #marker_id temp
                        scoreboard players set @s got_block 0
                
                if entity @s[tag=mirrored]:
                    positioned ^mirror_pos ^pos[1] ^pos[2] summon item_display:
                        data merge entity @s {transformation:{left_rotation:[0f,0f,0f,1f],right_rotation:[0f,0f,0f,1f],translation:[0f,0f,0f],scale:[0.6f,0.6f,0.6f]},item:{id:"minecraft:lava_bucket"},Tags:[(curr_mtb_id), (block_stripped)]}
                        scoreboard players operation @s mtb_id = #marker_id temp
                        scoreboard players set @s got_block 0

    # ------------------------------------------------------------------------------------------------------------------------------------------
        
    function f"mtb-generated:{curr_mtb_id}/multiblock_block_check":
            for block in structs_OOP[curr_mtb_id].palette:
                if entity @s[tag=(block.replace("minecraft:", ""))]:        
                    # nb=no block (0), wb = wrong block (1), rb = right block (2)
                    # was nb
                    function mtb:find_id
                    if score @s got_block matches 0 run return:
                        #to nb
                        if block ~ ~ ~ minecraft:air run return:
                            pass
                        #to wb
                        unless block ~ ~ ~ minecraft:air unless block ~ ~ ~ (block) run return:
                            @debug << [{"text":"Wrong block was placed","color":"red"}]
                            scoreboard players set @s got_block 1
                            summon item_display ~ ~ ~ {item:{id:"minecraft:poisonous_potato",count:1,components:{"minecraft:item_model":"minecraft:red_stained_glass"}},Tags:[outline],transformation:{left_rotation:[0f,0f,0f,1f],right_rotation:[0f,0f,0f,1f],translation:[0f,0f,0f],scale:[1.01f,1.01f,1.01f]},brightness:{sky:15,block:15}}
                        #to rb
                        if block ~ ~ ~ (block) run return:
                            scoreboard players set @s got_block 2
                            @debug << [{"text":f"{block} was placed","color":"green"}]
                            execute as @e[predicate=mtb:match_id,type=marker,tag=(curr_mtb_id)] scoreboard players add @s mtb_complete 1
                    
                    #was wb
                    if score @s got_block matches 1 run return:
                        #to nb
                        if block ~ ~ ~ minecraft:air run return:
                            kill @e[distance=..0.1, type=item_display, tag=outline]
                            @debug << [{"text":"Wrong block removed","color":"gold"}]
                            scoreboard players set @s got_block 0
                        #to wb
                        unless block ~ ~ ~ minecraft:air unless block ~ ~ ~ (block) run return:
                            pass
                        #to rb
                        if block ~ ~ ~ (block) run return:
                            kill @e[distance=..0.1, type=item_display, tag=outline]
                            scoreboard players set @s got_block 2
                            @debug << [{"text":f"{block} was placed","color":"green"}]
                            execute as @e[predicate=mtb:match_id,type=marker,tag=(curr_mtb_id)] scoreboard players add @s mtb_complete 1
                    # was rb
                    if score @s got_block matches 2 run return:
                        #to nb
                        if block ~ ~ ~ minecraft:air run return:
                            @debug << [{"text":"Right block removed","color":"red"}]
                            execute as @e[predicate=mtb:match_id,type=marker,tag=(curr_mtb_id)] scoreboard players remove @s mtb_complete 1
                            scoreboard players set @s got_block 0
                        #to wb
                        unless block ~ ~ ~ minecraft:air unless block ~ ~ ~ (block) run return:
                            @debug << [{"text":"Right block was switched with wrong block","color":"red"}]
                            scoreboard players set @s got_block 1
                            summon item_display ~ ~ ~ {item:{id:"minecraft:poisonous_potato",count:1,components:{"minecraft:item_model":"minecraft:red_stained_glass"}},Tags:[outline],transformation:{left_rotation:[0f,0f,0f,1f],right_rotation:[0f,0f,0f,1f],translation:[0f,0f,0f],scale:[1.01f,1.01f,1.01f]},brightness:{sky:15,block:15}}
                            execute as @e[predicate=mtb:match_id ,type=marker,tag=(curr_mtb_id)] scoreboard players remove @s mtb_complete 1
                        #to rb
                        if block ~ ~ ~ (block) run return:
                            pass

    # ------------------------------------------------------------------------------------------------------------------------------------------

    #TODO: In deze functie moet oftewel een callback function, oftewel moet de user de build nog confirmen
    #Ik zou aanraden een callback te doen, en een build functie te ondersteunen, en de logic aan de user overlaten
    function f"mtb-generated:{curr_mtb_id}/multiblock_check":
        if score @s mtb_complete matches len(structs_OOP[curr_mtb_id].blocks):
            say "Full house!"
    
    # ------------------------------------------------------------------------------------------------------------------------------------------

    function f"mtb-generated:{curr_mtb_id}/build":
        pass
    # ------------------------------------------------------------------------------------------------------------------------------------------
    # rotate function (TODO: Laten uitvoeren als de marker misschien, of iets anders)

    function f"mtb-generated:{curr_mtb_id}/rotate":
        scoreboard players set @e[limit=1,sort=nearest,type=marker,tag=curr_mtb_id, predicate=mtb:match_id] mtb_complete 0
            kill @e[sort=nearest, type=minecraft:block_display, predicate=mtb:match_id]  # TODO: moet nog een opitmise voor vinden (max = mtb block amount?)
            kill @e[sort=nearest, type=minecraft:item_display, predicate=mtb:match_id]
            execute as @e[sort=nearest, type=marker, predicate=mtb:match_id, limit=1] at @s:
                rotate @s facing ^90 ^ ^
                execute rotated as @s run function f"mtb-generated:{curr_mtb_id}/multiblock_init"
            scoreboard players set @p[sort=nearest, predicate=mtb:match_id, limit=1] rotate 0


    # ------------------------------------------------------------------------------------------------------------------------------------------
    # mirror function (TODO: Laten uitvoeren als de marker misschien, of iets anders)

    function f"mtb-generated:{curr_mtb_id}/mirror":
        scoreboard players set @e[limit=1, sort=nearest,type=marker,tag=curr_mtb_id, predicate=mtb:match_id] mtb_complete 0
                    kill @e[sort=nearest, type=minecraft:block_display, predicate=mtb:match_id] # TODO: moet nog een opitmise voor vinden (max = mtb block amount?)
                    kill @e[sort=nearest, type=minecraft:item_display, predicate=mtb:match_id]
                    execute as @e[sort=nearest, type=marker, predicate=mtb:match_id, limit=1] at @s:
                        execute if entity @s[tag=mirrored] run tag @s add was_mirrored
                        execute if entity @s[tag=was_mirrored] run tag @s remove mirrored
                        execute unless entity @s[tag=was_mirrored] run tag @s add mirrored
                        execute if entity @s[tag=was_mirrored] run tag @s remove was_mirrored
                        function f"mtb:{curr_mtb_id}/multiblock_init"
                    scoreboard players set @p[sort=nearest, predicate=mtb:match_id, limit=1] mirror 0


# item_display
#summon block_display ~ ~ ~ {transformation:{left_rotation:[0f,0f,0f,1f],right_rotation:[0f,0f,0f,1f],translation:[-0.3f,-0.3f,-0.3f],scale:[0.6f,0.6f,0.6f]},block_state:{Name:"minecraft:dirt"}}


# ==========================================================================================================================================
# ------------------------------------------------------------------------------------------------------------------------------------------
##                                                         GENERIC COMMON CODE                                                                       
# ------------------------------------------------------------------------------------------------------------------------------------------
# ==========================================================================================================================================

# -------------------------------
## LOAD FUNCTIONS
# -------------------------------

function mtb:load:
    execute store result score #mtb.debug_enabled temp if entity @a[tag=mtb.debug]
    @debug << [{"text": "[Server]: Multiblocks v__pack_major__.__pack_minor__ loaded successfully","color":"green"}]
    scoreboard objectives add mtb_complete dummy
    scoreboard objectives add got_block dummy
    scoreboard objectives add mtb_id dummy

    scoreboard objectives add mirror trigger
    scoreboard objectives add rotate trigger

    scoreboard objectives add temp dummy


#------------------
## TICK FUNCTIONS
#------------------

function mtb:tick:
    execute as @a at @s run function mtb:player

function mtb:player:
    scoreboard players enable @s mirror
    scoreboard players enable @s rotate

    for curr_mtb_id in structs_OOP.keys():
        execute at @e[distance=..10,type=marker,tag=rotor, tag=INIT, tag=curr_mtb_id] align xyz positioned ~0.50 ~ ~0.50 run function f"mtb-generated:{curr_mtb_id}/spawn_marker"

        #TODO: deze wil ik slow ticken of schedulen, moet niet elke tick denk ik
        execute as @e[distance=..10,type=#mtb:display,tag=curr_mtb_id] at @s align xyz positioned ~0.50 ~0.50 ~0.50 run function f"mtb-generated:{curr_mtb_id}/multiblock_block_check" 
        execute as @e[distance=..10,type=marker,tag=curr_mtb_id] at @s align xyz positioned ~0.50 ~0.50 ~0.50 run function f"mtb-generated:{curr_mtb_id}/multiblock_check" # TODO: Macro voor callback toevoegen

# -------------------------------
## MULTIBLOCK ID UTILITIES
# -------------------------------

function mtb:assign_id:
    scoreboard players operation @s mtb_id = .max mtb_id
    tag @s add has_mtb_id
    # Increment the max player ID by one
    scoreboard players add .max mtb_id 1

function mtb:find_id:
    # Set .this to the current entity's ID
    scoreboard players operation .this mtb_id = @s mtb_id