#-----------------------------------------------------------------------------------------------------------------------------------------------------
##        SETTINGS
#-----------------------------------------------------------------------------------------------------------------------------------------------------
# settings used to balance the minigame

#-----------------------------------------------------------------------------------------------------------------------------------------------------
##        INCLUDES
#-----------------------------------------------------------------------------------------------------------------------------------------------------
# Import all the things we need
import mtb:struct_scanner as struct_scanner

#-----------------------------------------------------------------------------------------------------------------------------------------------------
##    PYTHON UTILITIES
#-----------------------------------------------------------------------------------------------------------------------------------------------------
# helper python functions used by any of the stages

#-----------------------------------------------------------------------------------------------------------------------------------------------------
##    GENERATION STAGE
#-----------------------------------------------------------------------------------------------------------------------------------------------------
# The generation stage generates all resourcepack files that can be generated using code


#-----------------------------------------------------------------------------------------------------------------------------------------------------
##      DATA STAGE
#-----------------------------------------------------------------------------------------------------------------------------------------------------
# generate all datapack files
structs = {}
for struct in struct_scanner.get_structure_list():
    structs[struct[0]] = struct[1::]

structs_OOP = {}
for struct in struct_scanner.create_structures():
    structs_OOP[struct.id] = struct






# -------------------------------
# Match mtb id predicate                            
# -------------------------------




#-----------------------------------------------------------------------------------------------------------------------------------------------------
##       RUN STAGE
#-----------------------------------------------------------------------------------------------------------------------------------------------------
# All functions that run during the game




# ==========================================================================================================================================
# ------------------------------------------------------------------------------------------------------------------------------------------
##                                                      Multiblock Specific Code                                                                       
# ------------------------------------------------------------------------------------------------------------------------------------------
# ==========================================================================================================================================


for curr_mtb_id in structs_OOP.keys():


    #-------------------------------------------------------------
    ## Add all user-interacted functions to tags for easier use
    #-------------------------------------------------------------


    #-------------------------------------------------------
    ## MAIN INTERNAL CODE
    #-------------------------------------------------------


                

    function f"mtb-generated:{curr_mtb_id}/multiblock_init": # Misschien nog een betere naam bedenken

        center = structs_OOP[curr_mtb_id].center
        center_y = center[1]+0.5
        center_z = center[2]
        tp @s ^ ^center_y ^center_z

        tag @s remove INIT
        execute unless entity @s[tag=has_mtb_id] run function mtb:assign_id

        $$(on_place) # run the onplace event
        
        scoreboard players operation #marker_id temp = @s mtb_id
        scoreboard players operation #marker_id temp = @s mtb_id

        for blockdata in structs_OOP[curr_mtb_id].blocks:
            block = blockdata.id
            block_stripped = blockdata.stripped_id
            pos = blockdata.pos
            mirror_pos = pos[0]*(-1)

            # ======= Handle most block display summons =======

    # ------------------------------------------------------------------------------------------------------------------------------------------
        
    function f"mtb-generated:{curr_mtb_id}/multiblock_block_check":
            for block in structs_OOP[curr_mtb_id].palette:
                if entity @s[tag=(block.replace("minecraft:", ""))]:        
                    # nb=no block (0), wb = wrong block (1), rb = right block (2)
                    # was nb
                    function mtb:find_id
                    scoreboard players operation #marker_id temp = @s mtb_id
                    if score @s got_block matches 0 run return:
                        #to nb
                        if block ~ ~ ~ minecraft:air run return:
                            pass
                        #to wb
                        unless block ~ ~ ~ minecraft:air unless block ~ ~ ~ (block) run return:
                            @debug << [{"text":"Wrong block was placed","color":"red"}]
                            scoreboard players set @s got_block 1
                            execute at @s summon item_display:
                                data merge entity @s {item:{id:"minecraft:poisonous_potato",count:1,components:{"minecraft:item_model":"minecraft:red_stained_glass"}},Tags:[outline],transformation:{left_rotation:[0f,0f,0f,1f],right_rotation:[0f,0f,0f,1f],translation:[0f,0f,0f],scale:[1.01f,1.01f,1.01f]},brightness:{sky:15,block:15}}
                                scoreboard players operation @s mtb_id = #marker_id temp
                        #to rb
                        if block ~ ~ ~ (block) run return:
                            scoreboard players set @s got_block 2
                            @debug << [{"text":f"{block} was placed","color":"green"}]
                            execute as @e[predicate=mtb:match_id,type=marker,tag=(curr_mtb_id)] scoreboard players add @s mtb_complete 1
                    
                    #was wb
                    if score @s got_block matches 1 run return:
                        #to nb
                        if block ~ ~ ~ minecraft:air run return:
                            kill @e[distance=..0.1, type=item_display, tag=outline]
                            @debug << [{"text":"Wrong block removed","color":"gold"}]
                            scoreboard players set @s got_block 0
                        #to wb
                        unless block ~ ~ ~ minecraft:air unless block ~ ~ ~ (block) run return:
                            pass
                        #to rb
                        if block ~ ~ ~ (block) run return:
                            kill @e[distance=..0.1, type=item_display, tag=outline]
                            scoreboard players set @s got_block 2
                            @debug << [{"text":f"{block} was placed","color":"green"}]
                            execute as @e[predicate=mtb:match_id,type=marker,tag=(curr_mtb_id)] scoreboard players add @s mtb_complete 1
                    # was rb
                    if score @s got_block matches 2 run return:
                        #to nb
                        if block ~ ~ ~ minecraft:air run return:
                            @debug << [{"text":"Right block removed","color":"red"}]
                            execute as @e[predicate=mtb:match_id,type=marker,tag=(curr_mtb_id)] scoreboard players remove @s mtb_complete 1
                            scoreboard players set @s got_block 0
                        #to wb
                        unless block ~ ~ ~ minecraft:air unless block ~ ~ ~ (block) run return:
                            @debug << [{"text":"Right block was switched with wrong block","color":"red"}]
                            scoreboard players set @s got_block 1
                            execute at @s summon item_display:
                                data merge entity @s {item:{id:"minecraft:poisonous_potato",count:1,components:{"minecraft:item_model":"minecraft:red_stained_glass"}},Tags:[outline],transformation:{left_rotation:[0f,0f,0f,1f],right_rotation:[0f,0f,0f,1f],translation:[0f,0f,0f],scale:[1.01f,1.01f,1.01f]},brightness:{sky:15,block:15}}
                                scoreboard players operation @s mtb_id = #marker_id temp
                            execute as @e[predicate=mtb:match_id ,type=marker,tag=(curr_mtb_id)] scoreboard players remove @s mtb_complete 1
                        #to rb
                        if block ~ ~ ~ (block) run return:
                            pass

    # ------------------------------------------------------------------------------------------------------------------------------------------


    function f"mtb-generated:{curr_mtb_id}/multiblock_check":
        raw f'$execute if score @s mtb_complete matches {len(structs_OOP[curr_mtb_id].blocks)} run $(on_complete)'

    # ------------------------------------------------------------------------------------------------------------------------------------------
    # Build and remove function

    append function_tag f"mtb-generated:{curr_mtb_id}/build_blueprint" {
        "values": [
            {"id": f"mtb-generated:{curr_mtb_id}/remove", "required": false}
        ]
    }

    function f"mtb-generated:{curr_mtb_id}/remove":
        function mtb:find_id
        kill @e[predicate=mtb:match_id,tag=(curr_mtb_id)]
    # ------------------------------------------------------------------------------------------------------------------------------------------
    # rotate function

    function f"mtb-generated:{curr_mtb_id}/rotate":
        scoreboard players set @e[limit=1,sort=nearest,type=marker,tag=curr_mtb_id, predicate=mtb:match_id] mtb_complete 0
            kill @e[sort=nearest, type=minecraft:block_display, predicate=mtb:match_id]  # TODO: moet nog een opitmise voor vinden (max = mtb block amount?)
            kill @e[sort=nearest, type=minecraft:item_display, predicate=mtb:match_id]
            execute as @e[sort=nearest, type=marker, predicate=mtb:match_id, limit=1] at @s:
                rotate @s facing ^90 ^ ^
                execute rotated as @s run function f"mtb-generated:{curr_mtb_id}/multiblock_init"
            scoreboard players set @p[sort=nearest, predicate=mtb:match_id, limit=1] rotate 0


    # ------------------------------------------------------------------------------------------------------------------------------------------
    # mirror function

    function f"mtb-generated:{curr_mtb_id}/mirror":
        scoreboard players set @e[limit=1, sort=nearest,type=marker,tag=curr_mtb_id, predicate=mtb:match_id] mtb_complete 0
                    kill @e[sort=nearest, type=minecraft:block_display, predicate=mtb:match_id] # TODO: moet nog een opitmise voor vinden (max = mtb block amount?)
                    kill @e[sort=nearest, type=minecraft:item_display, predicate=mtb:match_id]
                    execute as @e[sort=nearest, type=marker, predicate=mtb:match_id, limit=1] at @s:
                        execute if entity @s[tag=mirrored] run tag @s add was_mirrored
                        execute if entity @s[tag=was_mirrored] run tag @s remove mirrored
                        execute unless entity @s[tag=was_mirrored] run tag @s add mirrored
                        execute if entity @s[tag=was_mirrored] run tag @s remove was_mirrored
                        function f"mtb:{curr_mtb_id}/multiblock_init"
                    scoreboard players set @p[sort=nearest, predicate=mtb:match_id, limit=1] mirror 0


# item_display
#summon block_display ~ ~ ~ {transformation:{left_rotation:[0f,0f,0f,1f],right_rotation:[0f,0f,0f,1f],translation:[-0.3f,-0.3f,-0.3f],scale:[0.6f,0.6f,0.6f]},block_state:{Name:"minecraft:dirt"}}

# -------------------------------
## LOAD FUNCTIONS
# -------------------------------

    ## DEZE MOET GE NOG RUNNEN IN DE FUNCTION TAG
    function f"mtb-generated/{curr_mtb_id}/init_storage":
        data modify storage f"mtb-generated:{curr_mtb_id}" callback set value (structs_OOP[curr_mtb_id].callback)

# ==========================================================================================================================================
# ------------------------------------------------------------------------------------------------------------------------------------------
##                                                         GENERIC COMMON CODE                                                                       
# ------------------------------------------------------------------------------------------------------------------------------------------
# ==========================================================================================================================================

# -------------------------------
## LOAD FUNCTIONS
# -------------------------------



#------------------
## TICK FUNCTIONS
#------------------


## DEZE MOET GE NOG VERPLAATSEN IN EEN FUNCTION TAG
function mtb:player:
    for curr_mtb_id in structs_OOP.keys():
        #TODO: deze wil ik slow ticken of schedulen, moet niet elke tick denk ik (player block place advancement)
        execute as @e[distance=..10,type=#mtb:display,tag=curr_mtb_id] at @s align xyz positioned ~0.50 ~0.50 ~0.50 run function f"mtb-generated:{curr_mtb_id}/multiblock_block_check" 
        execute as @e[distance=..10,type=marker,tag=curr_mtb_id] at @s align xyz positioned ~0.50 ~0.50 ~0.50 run function f"mtb-generated:{curr_mtb_id}/multiblock_check" with storage f"mtb-generated:{curr_mtb_id}" callback

