# make all the individual parts ride the center mtb marker
tag @s add THIS
execute as @e[type=minecraft:block_display,tag=cb.copper_coil_marker,tag=INIT] run ride @s mount @e[type=minecraft:block_display,tag=THIS,limit=1]
execute rotated as @s as @e[type=minecraft:block_display,tag=cb.copper_coil_marker,tag=INIT] run rotate @s ~90 ~
tag @s remove THIS

tag @e[type=minecraft:block_display,tag=cb.copper_coil_marker,tag=INIT] remove INIT

# This multiblock instance now has the custom block markers
tag @s add cb.has_custom_markers