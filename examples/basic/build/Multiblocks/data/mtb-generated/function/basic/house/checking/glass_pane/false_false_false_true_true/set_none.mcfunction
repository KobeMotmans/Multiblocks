execute if score #mtb.debug_enabled temp matches 1 run tellraw @a[tag=mtb.debug] [{"text":"[Debug]: Removed block","color":"gold"}]
function mtb:v0.1.2-alpha/find_id
execute if score @s mtb_prev_state matches 2 as @e[predicate=mtb:v0.1.2-alpha/match_id,type=marker,tag=mtb.basic-house] run scoreboard players remove @s mtb_complete 1
